# Optional: Gentic2 Connect source builds
# `cp .env.example .env` enables Gentic2 Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
GENTIC2_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
GENTIC2_CLERK_JWT_TEMPLATE=g2-relay
GENTIC2_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in GENTIC2_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# GENTIC2_APPLE_TEAM_ID=ABC1234567
# GENTIC2_MACOS_PROVISIONING_PROFILE=/absolute/path/to/gentic2.provisionprofile
# GENTIC2_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
GENTIC2_RELAY_URL=https://relay.gentic2.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.gentic2.com; override to test against a staging deployment.
# GENTIC2_HOSTED_APP_URL=https://nightly.app.gentic2.com

# Public, ingest-only mobile OpenTelemetry configuration.
# GENTIC2_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# GENTIC2_MOBILE_OTLP_TRACES_DATASET=gentic2-mobile-traces-dev
# GENTIC2_MOBILE_OTLP_TRACES_TOKEN=xaat-...
